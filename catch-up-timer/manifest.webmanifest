{
  "name": "Catch-Up Timer",
  "short_name": "Catch-Up",
  "description": "See who you're overdue to call or see, and tap their card when you catch up.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#111219",
  "theme_color": "#3540a0",
